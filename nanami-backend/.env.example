# ---------------------------------------------------------------------------
# App (usado pelo `npm run dev` e pelo `npm start`)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Onde ficam o SQLite e os uploads. No Docker viram /data e /uploads.
DATA_DIR=data
UPLOAD_DIR=uploads

# Primeiro admin. Sem ADMIN_PASSWORD, uma senha aleatória é gerada e impressa
# uma única vez no log do primeiro boot.
ADMIN_EMAIL=admin@nanami.com.br
ADMIN_PASSWORD=

# URL pública do site. Obrigatória em produção (ex.: https://nanami.com.br).
# Com o Caddy local (HTTPS com certificado interno) use https://localhost.
# O compose já assume https://localhost quando esta variável está vazia.
PUBLIC_ORIGIN=

# Confie em X-Forwarded-For do proxy (Caddy/Nginx). 1 = ligado.
TRUST_PROXY=0

# Pasta com o build do front (só em produção sem Docker).
STATIC_DIR=

# Teto de requisições por IP na API a cada 5 min.
API_RATE_LIMIT_MAX=600

# ---------------------------------------------------------------------------
# Docker (lido pelo docker compose)
# ---------------------------------------------------------------------------
# Domínio público. "localhost" usa o certificado interno do Caddy (aviso no
# navegador). Em produção: nanami.com.br
DOMAIN=localhost
